# GShare runtime configuration (all GSHARE_* variables).
# Copy to .env and fill in. Never commit real secrets.
# `hack/gen-secrets.sh` generates a populated file; pass --k8s to emit Kubernetes Secrets instead.

# ── Datastores ──
GSHARE_DATABASE_URL=postgresql+asyncpg://gshare:gshare@localhost:5432/gshare
GSHARE_REDIS_URL=redis://localhost:6379/0

# ── End-user authentication (HS256) ──
# The API refuses to start without a signing key. Generate one with: openssl rand -hex 32
GSHARE_AUTH_ALLOW_LOCAL_PASSWORD=true
GSHARE_USER_JWT_SECRET=change-this-secret

# ── Bootstrap administrator (forced to change the password on first login) ──
GSHARE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
GSHARE_BOOTSTRAP_ADMIN_PASSWORD=change-me-please

# ── Internal plane RS256 JWT ──
# Generate with: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
GSHARE_INTERNAL_JWT_PRIVATE_KEY=
GSHARE_INTERNAL_JWT_KID=internal
# JWKS endpoint the API fetches to verify its own tokens; locally that is itself.
GSHARE_INTERNAL_JWKS_URL=http://localhost:8080/.well-known/gshare-internal-jwks.json

# ── Session connect routing ──
# Console/ingress domain of the cluster that runs the sessions.
GSHARE_SESSION_DOMAIN=gshare.example.com
GSHARE_SESSION_URL_SCHEME=https
# Optional, Compose + single external cluster only: relay /proxy/ session traffic to that
# cluster's ingress NodePort. The console and the session apps sit behind different backends,
# so without this the console cannot reach sessions. Leave unset to disable relaying.
# The host must match the operator's SESSION_DOMAIN / GSHARE_SESSION_DOMAIN.
# GSHARE_SESSION_INGRESS=10.0.0.10:30080

# ── Billing knobs ──
GSHARE_CONNECTION_TOKEN_TTL_SEC=300
GSHARE_BILLING_INTERVAL_SEC=60
