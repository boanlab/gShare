+
+package nvidia
+
+import (
+	"testing"
+
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+
+	"github.com/Project-HAMi/HAMi/pkg/device"
+)
+
+// GShare in-place-yield borrow: a preemptible pod fits onto a fully-occupied card iff that card
+// is yielded (owner VRAM evicted); non-preemptible pods and non-yielded cards are unaffected.
+func TestFit_GShareYieldedBorrow(t *testing.T) {
+	nv := InitNvidiaDevice(NvidiaConfig{
+		ResourceCountName:            "nvidia.com/gpu",
+		ResourceMemoryName:           "nvidia.com/gpumem",
+		ResourceCoreName:             "nvidia.com/gpumem",
+		ResourceMemoryPercentageName: "nvidia.com/gpumem-percentage",
+	})
+	req := device.ContainerDeviceRequest{Nums: 1, Memreq: 512, Coresreq: 50, Type: NvidiaGPUDevice}
+
+	// A fully-occupied card (owner using all slices/mem/cores).
+	fullCard := func(yielded bool) []*device.DeviceUsage {
+		return []*device.DeviceUsage{{
+			ID: "gpu-yield", Index: 0, Used: 100, Count: 100,
+			Usedmem: 1280, Totalmem: 1280, Usedcores: 100, Totalcore: 100,
+			Numa: 0, Type: NvidiaGPUDevice, Health: true, Yielded: yielded,
+		}}
+	}
+	pod := func(preemptible bool) *corev1.Pod {
+		annos := map[string]string{}
+		if preemptible {
+			annos["gshare.io/preemptible"] = "true"
+		}
+		return &corev1.Pod{ObjectMeta: metav1.ObjectMeta{Annotations: annos}}
+	}
+
+	cases := []struct {
+		name                    string
+		yielded, preempt, wantFit bool
+	}{
+		{"preemptible borrow fits on yielded card", true, true, true},
+		{"non-preemptible rejected on yielded card", true, false, false},
+		{"preemptible rejected on non-yielded full card", false, true, false},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			fit, _, _ := nv.Fit(fullCard(c.yielded), req, pod(c.preempt), &device.NodeInfo{}, &device.PodDevices{})
+			if fit != c.wantFit {
+				t.Fatalf("Fit=%v want %v", fit, c.wantFit)
+			}
+		})
+	}
+}
diff --git a/pkg/scheduler/scheduler.go b/pkg/scheduler/scheduler.go
index 57d40a5..ac18e34 100644
--- a/pkg/scheduler/scheduler.go
+++ b/pkg/scheduler/scheduler.go
@@ -522,6 +522,24 @@ func (s *Scheduler) InspectAllNodesUsage() *map[string]*NodeUsage {
 
 // returns all nodes and its device memory usage, and we filter it with nodeSelector, taints, nodeAffinity
 // unschedulerable and nodeName.
+// gshareYieldedAnnotation lists (CSV) the GPU UUIDs on a node that GShare has in-place-yielded
+// (VRAM evicted, physically free). The GShare operator publishes it.
+const gshareYieldedAnnotation = "gshare.io/yielded-gpus"
+
+// gshareYieldedGPUs returns the set of yielded GPU UUIDs published on the node.
+func gshareYieldedGPUs(node *corev1.Node) map[string]bool {
+	out := map[string]bool{}
+	if node == nil {
+		return out
+	}
+	for _, u := range strings.Split(node.GetAnnotations()[gshareYieldedAnnotation], ",") {
+		if u = strings.TrimSpace(u); u != "" {
+			out[u] = true
+		}
+	}
+	return out
+}
+
