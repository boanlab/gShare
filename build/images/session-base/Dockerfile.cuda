# The GShare GPU session image: a CUDA runtime plus the interactive session tools (VS Code,
# JupyterLab, web terminal).
# It honours the same connection contract as session-base — the same ports, paths, and entrypoint —
# with only the base swapped for CUDA.
# code-server is copied from its official image in a multi-stage build, bundled Node included. Runs as
# non-root (uid 1000).
FROM codercom/code-server:latest AS cs

FROM nvidia/cuda:13.3.1-cudnn-runtime-ubuntu22.04
ARG TTYD_VERSION=1.7.7

# Copy in code-server, which bundles its own Node.
COPY --from=cs /usr/lib/code-server /usr/lib/code-server
COPY --from=cs /usr/bin/code-server /usr/bin/code-server

# Runtime dependencies, plus the `coder` user at uid 1000.
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3-pip python3-venv iproute2 tini ca-certificates wget git criu && \
    rm -rf /var/lib/apt/lists/* && \
    useradd -m -u 1000 -s /bin/bash coder
RUN pip3 install --no-cache-dir jupyterlab notebook
RUN wget -qO /usr/local/bin/ttyd \
      "https://github.com/tsl0922/ttyd/releases/download/${TTYD_VERSION}/ttyd.x86_64" && \
    chmod +x /usr/local/bin/ttyd

COPY entrypoint.sh /usr/local/bin/gshare-session
RUN chmod +x /usr/local/bin/gshare-session

USER 1000
ENV HOME=/home/coder
EXPOSE 8080 8888 7681
ENTRYPOINT ["tini", "--", "/usr/local/bin/gshare-session"]
